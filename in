#include <iostream>
using namespace std;

int main() {
    int n;
    
    while (cin >> n) {
        for (int i = 1; i <= n; i++) {
            cout << i;
            
            switch (i % 3) {
                case 1:
                    cout << "+";
                    break;
                case 2:
                    cout << "--";
                    break;
                case 0:
                    cout << "***";
                    break;
            }
        }
        
        cout << endl;
    }

    return 0;
}
